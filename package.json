{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:policy": "tsx src/app/__tests__/policySmoke.ts",
    "check:types": "tsc --noEmit",
    "check": "npm run check:types && npm run test:policy && npm run test:rust && npm run test:core && npm run test:vault && npm run test:browser-engine && npm run test:session-isolation && npm run test:permissions && npm run test:downloads && npm run test:audit-console && npm run test:webview-contract && npm run test:live-webview-binding && npm run test:live-webview-nav && npm run test:webview-decision-log && npm run test:webview-policy-badges",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:core": "tsx src/app/__tests__/coreSmoke.ts",
    "test:vault": "tsx src/app/__tests__/vaultSmoke.ts",
    "test:browser-engine": "tsx src/app/__tests__/browserEngineSmoke.ts",
    "test:session-isolation": "tsx src/app/__tests__/sessionIsolationSmoke.ts",
    "test:permissions": "tsx src/app/__tests__/permissionManagerSmoke.ts",
    "test:downloads": "tsx src/app/__tests__/downloadGuardSmoke.ts",
    "test:audit-console": "tsx src/app/__tests__/auditConsoleSmoke.ts",
    "test:webview-contract": "tsx src/app/__tests__/webViewContractSmoke.ts",
    "test:live-webview-binding": "tsx src/app/__tests__/liveWebViewBindingSmoke.ts",
    "test:live-webview-nav": "tsx src/app/__tests__/liveWebViewNavSmoke.ts",
    "test:webview-decision-log": "tsx src/app/__tests__/webViewDecisionLogSmoke.ts",
    "test:webview-policy-badges": "tsx src/app/__tests__/webViewPolicyBadgesSmoke.ts",
    "validate:packaged-webview": "node tests/validate-packaged-webview-validation.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "4.22.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
